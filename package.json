{
  "name": "WebEng",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"apps/*/src\" --ext .js,.ts,.tsx",
    "lint:fix": "eslint \"apps/*/src\" --ext .js,.ts,.tsx --fix",
    "format": "prettier --write \"apps/*/src/**/*.{js,ts,tsx}\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{js,ts,tsx}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/*/src/**/*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "ts-api-utils": "^2.5.0",
    "typescript": "~5.7.0"
  }
}